# ========================================================
# Hanzel Digital Store - Environment Variables Configuration
# ========================================================

# Password / PIN untuk login admin (Minimal 8 karakter di production)
ADMIN_PASSWORD=change_this_to_a_secure_admin_password_123

# Secret Key untuk enkripsi dan verifikasi session cookie HMAC-SHA256 (Minimal 32 karakter di production)
ADMIN_SESSION_SECRET=change_this_to_a_random_32_chars_secret_key_abc123xyz
